{
  "name": "cookie-notice",
  "version": "1.0.0",
  "description": "This repository provides the Cookie Notice banner used by the University of Illinois.",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
       "dev": "vite",
        "build": "tsc --noEmit && vite build --config vite.transpile.config.ts --emptyOutDir && vite build --config vite.build.config.ts --emptyOutDir",
        "preview": "vite preview",
        "prepack": "npm run build",
        "test:axe": "playwright test",
        "test:axe:github": "playwright test --config playwright.ci.config.ts",
        "test": "vitest run --browser.headless",
        "test:browser": "vitest browser --browser chromium"
    },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techservicesillinois/cookie-notice.git"
  },
  "keywords": [],
  "author": "",
  "license": "NCSA",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/techservicesillinois/cookie-notice/issues"
  },
  "homepage": "https://github.com/techservicesillinois/cookie-notice#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
        "@playwright/test": "^1.54.1",
        "@vitest/browser": "^3.2.4",
        "axe-html-reporter": "^2.2.11",
        "@illinois-toolkit/ilw-core": "^1.0.3",
        "playwright": "^1.54.1",
        "prettier": "^3.6.2",
        "typescript": "^5.8.3",
        "vite": "^7.0.5",
        "vite-plugin-dts": "^4.5.4",
        "vitest-browser-lit": "^0.1.0",
        "vite-plugin-nunjucks": "^0.2.0"
  }
}
